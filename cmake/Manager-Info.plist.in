<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>@CKMAC_DOMAIN@.Manager</string>
<key>CFBundleName</key><string>@CKMAC_DISPLAY_NAME@ Manager</string>
<key>CFBundleDisplayName</key><string>@CKMAC_DISPLAY_NAME@ Manager</string>
<key>CFBundleExecutable</key><string>@CKMAC_MANAGER_NAME@</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>@CKMAC_BUNDLE_VERSION@</string>
<key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>Local Maintenance</string><key>CFBundleURLSchemes</key><array><string>@CKMAC_URL_SCHEME@</string></array></dict></array>
</dict></plist>
